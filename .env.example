# ============================================
# 酒店 AI 智能管家 - 环境配置示例
# ============================================

# 应用配置
APP_NAME=hotel-ai-butler
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key

# 数据库
DATABASE_URL=sqlite:///./hotel_ai_butler.db

# AI 配置 (OpenAI-compatible API)
AI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=your-qwen-api-key-here
AI_MODEL=qwen-turbo

# 微信配置 (企业微信/公众号)
WECHAT_TOKEN=your-wechat-token
WECHAT_ENCODING_AES_KEY=your-encoding-aes-key
WECHAT_APP_ID=your-app-id
WECHAT_APP_SECRET=your-app-secret

# OTA 数据 API (合规第三方或官方 API)
OTA_API_BASE=https://api.example.com/ota
OTA_API_KEY=your-ota-api-key

# 电话 API (预留)
PHONE_API_BASE=https://api.example.com/phone
PHONE_API_KEY=your-phone-api-key

# 通知配置
NOTIFY_WEBHOOK_URL=https://your-webhook-url

# 定时任务 (cron 表达式)
SCHEDULER_ENABLED=true
